# ── OmniVoice Studio ─────────────────────────────────────────────────────────
# Copy this file to .env (make up does it automatically).

# Bind address. Keep 127.0.0.1 for local-only access.
BIND_ADDR=127.0.0.1
WEB_PORT=8088
ENGINE_PORT=8000

# "auto" lets the engine pick CUDA / XPU / CPU.
DEVICE=auto
OMNIVOICE_MODEL=k2-fsa/OmniVoice

# Whisper model used when a reference transcript is omitted.
# Use openai/whisper-small on slow CPUs or for a smaller download.
OMNIVOICE_ASR_MODEL=openai/whisper-large-v3-turbo
# Leave empty to run ASR on the same device as OmniVoice.
OMNIVOICE_ASR_DEVICE=
# 1 = load Whisper at startup (uses more VRAM); 0 = load on first auto-transcription.
OMNIVOICE_LOAD_ASR=0

# Hugging Face cache lives inside the data volume.
HF_ENDPOINT=https://huggingface.co
# HF_TOKEN=

# Limits
MAX_INPUT_CHARS=8000
MAX_UPLOAD_MB=50
MIN_VOICE_SECONDS=1
MAX_VOICE_SECONDS=30
MAX_QUEUE_SIZE=50
MAX_JOB_HISTORY=200

# CORS for direct browser API access. The bundled web app uses nginx, so this
# is only needed for custom clients. Use * only if you understand the tradeoff.
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

# Preview sentence used by the "Preview" button on trained voices.
OMNIVOICE_PREVIEW_TEXT=Hello! This is a preview of my trained voice. I hope you like how it sounds.

# Build-time PyTorch. Leave TORCH_INDEX_URL unset to use the CPU index for the
# CPU stack and the cu128 index for the GPU stack. Uncomment to pin another
# CUDA build, e.g. https://download.pytorch.org/whl/cu126
# TORCH_INDEX_URL=
TORCH_VERSION=2.8.0
